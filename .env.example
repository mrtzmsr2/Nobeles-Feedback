# --- Nobeles-Feedback Konfiguration ---

# Session-Geheimnis (mit `python -c "import secrets; print(secrets.token_hex(32))"` erzeugen)
SECRET_KEY=please-change-me-to-a-long-random-string

# Auf welcher Domain darf registriert werden (kommagetrennt für mehrere)
ALLOWED_EMAIL_DOMAINS=bcw-gruppe.de

# Initialer Admin (wird beim ersten Start angelegt, falls noch kein Admin existiert)
INITIAL_ADMIN_EMAIL=moritz.moser@bcw-gruppe.de
INITIAL_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
INITIAL_ADMIN_NAME=Moritz Moser

# Server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Basis-URL für QR-Codes (ohne Slash am Ende)
BASE_URL=http://localhost:5000

# Max Upload-Größe in MB (für Ticket-Fotos)
MAX_UPLOAD_MB=8
